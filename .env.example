# Pasokh settings. The installer writes this file for you; edit it only if you
# know what you are changing, then run `docker compose up -d` again.

# ── Required ─────────────────────────────────────────────────────────────────
# Long random secrets (the installer generates them): openssl rand -hex 32
NEXTAUTH_SECRET=
CRON_SECRET=
# Encrypts stored Instagram/Zernio keys. Never change it after the first start,
# or saved connections can no longer be read.
ENCRYPTION_KEY=
# Only while rotating the key (npm run keys:rotate, docs/DEPLOYMENT.fa.md): the old key(s).
# ENCRYPTION_KEY_PREVIOUS=
POSTGRES_PASSWORD=
# The first-run page (/setup) creates the owner for whoever reaches it first, so
# it stays locked until this is set (at least 16 characters; the installer
# generates one; to make your own: openssl rand -hex 32). Enter it on /setup, then you may leave it in place: once an
# owner exists /setup is closed anyway.
SETUP_TOKEN=

# ── How the world reaches this server ───────────────────────────────────────
# One of: quick | domain | cloudflare | (empty for local only)
# Left empty: the app is reachable only from this server (127.0.0.1). Create the
# owner first, then set `domain` (docs/DEPLOYMENT.fa.md). `quick` publishes a
# public tunnel at once and is not used in this deployment.
COMPOSE_PROFILES=
# quick tunnel only: PASOKH_TUNNEL=quick
PASOKH_TUNNEL=
# Which proxy sits in front, so rate limits can trust the visitor's address:
# REQUIRED with a domain: caddy (profile domain) or cloudflare (tunnel). Without
# it every visitor looks like one address and the sign-in limits can be used to
# lock people out. Empty (trust no header) only for local use.
# Wrong value = the address can be spoofed; leave empty if unsure.
TRUSTED_PROXY=
# domain / cloudflare: the public address, with https://
NEXTAUTH_URL=http://localhost:3000
# domain profile only: the bare domain Caddy gets a certificate for.
# PASOKH_DOMAIN=pasokh.example.com
# cloudflare profile only: the tunnel token from the Cloudflare dashboard.
# CLOUDFLARE_TUNNEL_TOKEN=

# ── Interface ───────────────────────────────────────────────────────────────
# fa (Persian, right-to-left) or en. Each person can still switch in the app.
DEFAULT_LOCALE=fa
TZ=Asia/Tehran

# ── Optional: email ─────────────────────────────────────────────────────────
# Not needed to sign in (Pasokh uses passwords). Set one of these to also offer
# one-time sign-in links by email.
# EMAIL_SERVER=smtps://user%40example.com:password@mail.example.com:465
# RESEND_API_KEY=re_...
# EMAIL_FROM=Pasokh <login@example.com>

# ── Optional: restrict who can sign in ──────────────────────────────────────
# REQUIRED when EMAIL_SERVER or RESEND_API_KEY is set: with an empty list,
# sign-in by emailed link is refused (it would create an account for any
# address). Comma separated.
# ALLOWED_EMAILS=you@example.com

# ── Optional: your own Meta app (instead of, or alongside, Zernio) ──────────
# See docs/setup.md. Needed for live-video comments.
# META_GRAPH_API_VERSION=v25.0
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# FACEBOOK_APP_SECRET=
# WEBHOOK_VERIFY_TOKEN=

# ── Optional: bulk SMS limits (per workspace) ───────────────────────────────
# A send needs a preview first and reaches only contacts who agreed to SMS.
# SMS_MAX_RECIPIENTS=200
# SMS_MAX_RECIPIENTS_PER_DAY=500

# ── Optional: AI assistant cost cap ─────────────────────────────────────────
# Most AI replies a workspace can use in 24 hours, across all people (every
# attempt counts, delivered or not). The per-person cap is set on the AI page.
# AI_MAX_REPLIES_PER_DAY=300

# ── Optional: how long data is kept (days; 0 = keep for ever) ───────────────
# Pruned daily. Contacts are never deleted.
# WEBHOOK_EVENT_RETENTION_DAYS=90
# DM_LOG_RETENTION_DAYS=180
# OPERATIONAL_EVENT_RETENTION_DAYS=90
# AI_REPLY_RETENTION_DAYS=180
# ZERNIO_EVENT_RECEIPT_RETENTION_DAYS=7
# ZERNIO_CLAIM_STALE_SECONDS=120
# AI_PENDING_STALE_MINUTES=5
# WEBHOOK_MAX_BODY_BYTES=262144
# ZERNIO_SENT_MESSAGE_RETENTION_DAYS=90

# ── Optional: limits on automatic replies to one sender ─────────────────────
# AUTO_REPLIES_PER_SENDER_PER_HOUR=20
# More messages than this from one sender in 60 seconds = a loop: pause for an hour.
# LOOP_MESSAGES_PER_MINUTE=10

# ── Optional: private reply cap ─────────────────────────────────────────────
# Meta's limit is 750 an hour per account; 600 leaves headroom (rolling hour).
# PRIVATE_REPLIES_PER_HOUR=600
# Hours a campaign leaves one person alone after DMing them from a comment (default 24, 0 = off).
# COMMENT_DM_COOLDOWN_HOURS=24

# ── Optional: repeated operational events ───────────────────────────────────
# The same kind of event within this many minutes is one row with a count.
# EVENT_COALESCE_MINUTES=10

# ── Advanced ────────────────────────────────────────────────────────────────
# REQUIRED. The exact image to run, pinned by digest (find it in the "Publish
# image" workflow summary): ghcr.io/exwarden/pasokh@sha256:<digest>
# For a local build: PASOKH_IMAGE=pasokh:local
PASOKH_IMAGE=
# Publish the web port beyond this machine (e.g. 0.0.0.0) and change it.
# REQUIRED on a server: keep 127.0.0.1 so the app port is never published to the
# internet; only Caddy or the tunnel (same host) may reach it. 0.0.0.0 is for
# a trusted LAN only.
PASOKH_BIND=127.0.0.1
# PASOKH_PORT=3000
